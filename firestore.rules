rules_version = '2';

// Security model for Pregnancy Companion.
//
// Principles (least privilege; every request must be authenticated):
//  - A user reads/writes only their OWN user document & medical profile.
//  - The pregnancy DOCUMENT is readable by any signed-in user: its id is an
//    unguessable Firestore auto-id that doubles as the family/doctor invite
//    code, so a person who has the code can look it up to join. The sensitive
//    tracker data underneath stays member-scoped.
//  - Tracker sub-data is readable by MEMBERS of that pregnancy and writable by
//    the owner (mother). The journal is private to the owner even from members.
//  - Community is a shared feed: signed-in users read; authors own their posts;
//    anyone may like / add a comment (bounded to those two fields).
//  - Roles come from custom claims set server-side (deferred to Cloud
//    Functions). Until claims exist, only owner/member access applies — which
//    matches today's app (the mother writes; partner/doctor read via
//    membership). The token.role checks are forward-compatible no-ops until then.
//
// NOTE (pre-launch TODO): the client-side invite/join flow lets a joining user
// add themselves to `members`. Harden invite/accept + patient-summary sharing
// with Cloud Functions before public launch.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function role() {
      // Null-safe: users without the custom claim get '' rather than an
      // evaluation error. Set via custom claims (Functions) for doctor/admin.
      return request.auth.token.get('role', '');
    }
    // Admin via a custom claim OR the user's own doc role. Trusting the doc
    // role is safe because a user can NEVER self-assign 'admin' (see the users
    // create/update rules) — it's set only via the Firebase console / Admin SDK.
    function isAdmin() {
      return isSignedIn() && (
        role() == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(uid()))
         && get(/databases/$(database)/documents/users/$(uid())).data.get('role', '') == 'admin')
      );
    }
    function isDoctor() {
      return isSignedIn() && role() == 'doctor';
    }
    function pregnancy(pid) {
      return get(/databases/$(database)/documents/pregnancies/$(pid)).data;
    }
    function isMember(pid) {
      // The pregnancy OWNER is always treated as a member of their own
      // pregnancy — even if the `members` map somehow doesn't list their uid
      // (data drift / a partial write). Without this, a mother can WRITE her
      // trackers (write rules use isPregnancyOwner) but not READ them back
      // (read rules use isMember), producing a "permission-denied" on load.
      return isSignedIn() &&
        (uid() in pregnancy(pid).members || pregnancy(pid).ownerUserId == uid());
    }
    function isPregnancyOwner(pid) {
      return isSignedIn() && pregnancy(pid).ownerUserId == uid();
    }
    // Whether a category is shared with members. Privacy-first: only the
    // "overview" categories default on when the mother hasn't chosen.
    function sharedCat(pid, cat) {
      return pregnancy(pid).get('sharing', {}).get(cat, cat in ['appointments', 'planning']);
    }
    // Read access to a category-gated tracker: the owner (and admin) always,
    // members only when the mother has shared that category.
    function canReadCat(pid, cat) {
      return isPregnancyOwner(pid) || isAdmin()
        || (isMember(pid) && sharedCat(pid, cat));
    }

    // Members with write scope: owner (mother) and the assigned doctor.
    function canWriteMedical(pid) {
      return isPregnancyOwner(pid)
        || (isDoctor() && pregnancy(pid).doctorUserId == uid())
        || isAdmin();
    }
    // A signed-in user adding THEMSELVES to a pregnancy (the join flow). Bounded
    // to the members/updatedAt fields; full invite hardening lands with Functions.
    // A self-join may only touch the CALLER'S OWN entry in the members map — it
    // can never remove, add, or re-role any other member — so a person with the
    // invite code can join but can't tamper with the rest of the family.
    function isSelfJoin(pid) {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'updatedAt'])
        && uid() in request.resource.data.members
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([uid()]);
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      // A user owns their own doc, but two fields are server-authoritative and
      // the client can never grant them to itself:
      //  - `role`: only non-privileged roles are self-assignable. 'doctor' and
      //    'admin' are provisioned server-side (Admin SDK / custom claims).
      //  - `isPremium`: the entitlement flag. Set only by a Cloud Function
      //    after verified billing; the client may never change it.
      allow create: if isSignedIn() && uid() == userId
        && request.resource.data.get('role', 'mother') in ['mother', 'husband', 'family']
        && request.resource.data.get('isPremium', false) == false;
      // An admin may update ANY user (e.g. to provision/revoke a doctor).
      // Otherwise a user may edit their OWN doc: a provisioned doctor/admin
      // keeps their role (unchanged is always allowed); only a *change* of role
      // is constrained to the safe set, so no one can self-elevate.
      allow update: if isAdmin() || (isSignedIn() && uid() == userId
        && (request.resource.data.get('role', 'mother') == resource.data.get('role', 'mother')
            || request.resource.data.get('role', 'mother') in ['mother', 'husband', 'family'])
        && request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false));
      allow delete: if isAdmin();

      // Medical profile — private to the owner. (Pre-launch TODO: share a
      // read-only patient summary with linked doctors via a denormalized doc
      // or a Function, rather than opening the whole profile.)
      match /profile/{doc} {
        allow read, write: if isSignedIn() && (uid() == userId || isAdmin());
      }
    }

    // ---------- pregnancies ----------
    match /pregnancies/{pid} {
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == uid();
      // Doc readable by any signed-in user (id acts as the invite code).
      allow read: if isSignedIn();
      allow update: if isPregnancyOwner(pid) || isSelfJoin(pid) || isAdmin();
      allow delete: if isPregnancyOwner(pid) || isAdmin();

      // Private diary — owner only, even from other members.
      match /journal/{docId} {
        allow read, write: if isPregnancyOwner(pid) || isAdmin();
      }
      // Daily mood calendar — emotional wellbeing, gated with the symptoms
      // sharing category (owner always; members only if shared).
      match /moods/{docId} {
        allow read: if canReadCat(pid, 'symptoms');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      // Personal reminders/alarms — owner only.
      match /reminders/{docId} {
        allow read, write: if isPregnancyOwner(pid) || isAdmin();
      }

      // Reads are gated by the mother's sharing choices (see canReadCat); the
      // owner always reads/writes. Writes stay owner-only (or assigned doctor
      // for medical logs).
      match /medicines/{docId} {
        allow read: if canReadCat(pid, 'medicines');
        allow write: if canWriteMedical(pid);
      }
      match /medicineLogs/{docId} {
        allow read: if canReadCat(pid, 'medicines');
        allow write: if canWriteMedical(pid);
      }
      match /appointments/{docId} {
        allow read: if canReadCat(pid, 'appointments');
        allow write: if canWriteMedical(pid);
      }
      match /vaccinations/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if canWriteMedical(pid);
      }

      // Self-logged trackers.
      match /symptoms/{docId} {
        allow read: if canReadCat(pid, 'symptoms');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /water/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /weight/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /blood_pressure/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /blood_sugar/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /sleep/{docId} {
        allow read: if canReadCat(pid, 'vitals');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /kick_sessions/{docId} {
        allow read: if canReadCat(pid, 'movements');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /contractions/{docId} {
        allow read: if canReadCat(pid, 'movements');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }

      // Planning & personal lists.
      match /hospital_bag/{docId} {
        allow read: if canReadCat(pid, 'planning');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /shopping/{docId} {
        allow read: if canReadCat(pid, 'planning');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /favoriteNames/{docId} {
        allow read: if canReadCat(pid, 'planning');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      match /birthPlan/{docId} {
        allow read: if canReadCat(pid, 'planning');
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }

      // Emergency contacts — always readable by members (important shared info);
      // only the owner manages them.
      match /emergency_contacts/{docId} {
        allow read: if isMember(pid);
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      // Blood donors directory — readable by members; managed by the owner.
      match /blood_donors/{docId} {
        allow read: if isMember(pid);
        allow write: if isPregnancyOwner(pid) || isAdmin();
      }
      // SOS alerts — any member may raise one; members read; the creator or
      // owner may resolve/delete it.
      match /sos_alerts/{docId} {
        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && request.resource.data.createdBy == uid();
        allow update, delete: if isPregnancyOwner(pid)
          || (isSignedIn() && resource.data.createdBy == uid());
      }
    }

    // ---------- global reference content (read-only to users) ----------
    match /weekContent/{week} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /babyNames/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /recipes/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /adminContent/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- community (shared feed) ----------
    match /community_posts/{postId} {
      allow read: if isSignedIn();
      // A new post is authored by the caller, starts with no likes and a zero
      // comment count, and carries non-empty, length-bounded text.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == uid()
        && request.resource.data.likedBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      // The author may edit/delete. Anyone signed in may either toggle THEIR
      // OWN like (likedBy is the only change, and their own membership flips)
      // or bump the comment count by exactly one (when adding a comment).
      allow update: if isSignedIn() && (
        resource.data.authorUid == uid()
        || isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
            && (uid() in resource.data.likedBy) != (uid() in request.resource.data.likedBy))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && request.resource.data.commentCount == resource.data.commentCount + 1)
      );
      allow delete: if isSignedIn()
        && (resource.data.authorUid == uid() || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isSignedIn()
          && (resource.data.authorUid == uid() || isAdmin());
      }
    }

    // NOTE: AI assistant chat is held in memory on the client (Phase 10); no
    // Firestore collection backs it. Add a rule here if chat is ever persisted.

    // ---------- notifications / invites ----------
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.toUserId == uid();
      allow create: if isAdmin(); // Functions create notifications
      allow update: if isSignedIn() && resource.data.toUserId == uid();
      allow delete: if isSignedIn() && resource.data.toUserId == uid();
    }
    match /invites/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == uid();
      allow update, delete: if isSignedIn() && resource.data.createdBy == uid();
    }

    // ---------- ops (server-only; Admin SDK bypasses rules) ----------
    match /analyticsRollups/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
